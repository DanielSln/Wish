{
  "expo": {
    "name": "Wish",
    "slug": "wish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/adaptive-foreground.png",
    "scheme": "wish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A9D8F4",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.danielsln.wish",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Embedder-Policy": "credentialless"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/brand/adaptive-foreground.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#101A23",
            "image": "./assets/brand/monochrome.png"
          },
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false,
          "photosPermission": "Selecione uma foto para o seu desejo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Embedder-Policy": "credentialless"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dea8d846-f32c-41e2-bf98-2a20f6fbe3d1"
      }
    },
    "owner": "danielsln"
  }
}
